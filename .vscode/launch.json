// Cross-platform .NET 10 launch configs for the inference-engine-lib library.
// Each cross-platform config uses VS Code's native per-platform override blocks
// (windows/osx/linux) so VS Code picks the matching block automatically. No env
// var setup required. Pick the config matching your host from the dropdown.
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "run all tests (X-Platform RID, Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests-debug",
            "program": "dotnet",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "windows": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Debug",
                    "--no-build"
                ]
            },
            "osx": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Debug",
                    "--no-build"
                ]
            },
            "linux": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Debug",
                    "--no-build"
                ]
            }
        },
        {
            "name": "run all tests (X-Platform RID, Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests-release",
            "program": "dotnet",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "windows": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Release",
                    "--no-build"
                ]
            },
            "osx": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Release",
                    "--no-build"
                ]
            },
            "linux": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Release",
                    "--no-build"
                ]
            }
        },
        {
            "name": "debug single test (X-Platform RID, Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-tests-debug",
            "program": "dotnet",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "windows": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Debug",
                    "--no-build",
                    "--filter",
                    "FullyQualifiedName~${input:testName}"
                ]
            },
            "osx": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Debug",
                    "--no-build",
                    "--filter",
                    "FullyQualifiedName~${input:testName}"
                ]
            },
            "linux": {
                "args": [
                    "test",
                    "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                    "-c",
                    "Debug",
                    "--no-build",
                    "--filter",
                    "FullyQualifiedName~${input:testName}"
                ]
            }
        },
        {
            "name": ".NET Core Launch (console, IntegrationTests, Debug, linux-x64)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-integration-tests-debug",
            "program": "${workspaceFolder}/InferenceEngine.Core.IntegrationTests/bin/Debug/net10.0/linux-x64/InferenceEngine.Core.IntegrationTests.dll",
            "args": [],
            "cwd": "${workspaceFolder}/InferenceEngine.Core.IntegrationTests",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "promptString",
            "description": "Test name pattern (e.g., FaceDetectionEngineTests.PredictAsync_WithBusImage)"
        }
    ]
}
