// Cross-platform .NET 10 build/test tasks for the inference-engine-lib library.
// All tasks use the DOTNET_RID env var to select the right RID:
//   - Set automatically by .vscode/settings.json (per-platform defaults)
//   - Override manually with `export DOTNET_RID=osx-x64` (Intel Mac, etc.)
//   - Falls back to `linux-x64` if unset (CI, fresh checkout)
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "restore",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "restore",
                "${workspaceFolder}/inference-engine-lib.slnx"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "build-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/inference-engine-lib.slnx",
                "-c",
                "Debug",
                "--no-incremental"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-release",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/inference-engine-lib.slnx",
                "-c",
                "Release",
                "--no-incremental"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "build-tests-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                "-c",
                "Debug",
                "--no-incremental"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "build-tests-release",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                "-c",
                "Release",
                "--no-incremental"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "build-integration-tests-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/InferenceEngine.Core.IntegrationTests/InferenceEngine.Core.IntegrationTests.csproj",
                "-c",
                "Debug",
                "--no-incremental"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "test-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                "-c",
                "Debug",
                "--no-build"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "test-release",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/InferenceEngine.Tests/InferenceEngine.Tests.csproj",
                "-c",
                "Release",
                "--no-build"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "test"
            }
        },
        {
            "label": "test-integration-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/InferenceEngine.Core.IntegrationTests/InferenceEngine.Core.IntegrationTests.csproj",
                "-c",
                "Debug",
                "--no-build"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "publish-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "publish",
                "${workspaceFolder}/InferenceEngine.Core.IntegrationTests/InferenceEngine.Core.IntegrationTests.csproj",
                "-c",
                "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "watch-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/InferenceEngine.Core.IntegrationTests/InferenceEngine.Core.IntegrationTests.csproj"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/inference-engine-lib.slnx",
                "-c",
                "Debug"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "clean-release",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/inference-engine-lib.slnx",
                "-c",
                "Release"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "validate-all",
            "dependsOrder": "sequence",
            "dependsOn": [
                "clean-release",
                "restore",
                "build-release",
                "test-release"
            ],
            "problemMatcher": []
        },
        {
            "type": "msbuild",
            "problemMatcher": [
                "$msCompile"
            ],
            "label": "Build: solution",
            "detail": "Build the inference-engine-lib.slnx solution (preserved from original config; prefer build-debug for explicit RID)"
        }
    ]
}
