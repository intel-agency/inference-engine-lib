    'IInferenceEngine.cs': r'''using System;
using System.Threading.Tasks;

namespace InferenceEngine.Core
{
    /// <summary>
    /// A generic contract for an AI Inference Engine.
    /// Implementation details (ONNX, TensorFlow, Mock) are abstracted away.
    /// </summary>
    /// <typeparam name="TInput">The type of input data (e.g., byte[] for images, string for text).</typeparam>
    /// <typeparam name="TOutput">The type of output data (e.g., List<Prediction>, string response).</typeparam>
    public interface IInferenceEngine<TInput, TOutput> : IDisposable
    {
        /// <summary>
        /// Initializes the engine, loads the model, and performs hardware warmup.
        /// This handles the "First Run" latency (e.g., DirectML graph compilation).
        /// </summary>
        Task LoadAsync();

        /// <summary>
        /// Runs the inference pipeline: PreProcess -> Inference -> PostProcess.
        /// </summary>
        /// <param name="input">The raw input data.</param>
        /// <returns>The processed prediction result.</returns>
        Task<TOutput> PredictAsync(TInput input);
    }
}
''',
    'InferenceEngineOptions.cs': r'''namespace InferenceEngine.Core
{
    public class InferenceEngineOptions
    {
        /// <summary>
        /// Absolute path to the .onnx model file.
        /// </summary>
        public string ModelPath { get; set; } = string.Empty;

        /// <summary>
        /// If true, attempts to use DirectML (Windows) or CoreML (macOS).
        /// If false, forces CPU execution.
        /// </summary>
        public bool UseGpuAcceleration { get; set; } = true;

        /// <summary>
        /// Specific GPU Device ID (default 0). Useful for multi-GPU setups.
        /// </summary>
        public int DeviceId { get; set; } = 0;

        /// <summary>
        /// If true, runs a dummy inference during LoadAsync to force 
        /// shader compilation/caching immediately.
        /// </summary>
        public bool WarmupOnLoad { get; set; } = true;
    }
}
