<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><!-- Critical for native DLL loading in local apps -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup><!-- Base Runtime (CPU) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" /><!-- Logging Abstraction -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" /><!-- Tensors support -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions" Version="0.8.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup><!-- Conditional References for Hardware Acceleration -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" />
<!-- <PackageReference Include="Microsoft.ML.OnnxRuntime.CoreML" Version="1.17.0"/> -->
  </ItemGroup>
</Project>