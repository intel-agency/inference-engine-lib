<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><!-- Critical for native DLL loading in local apps -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseRidGraph>true</UseRidGraph>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    
    <!-- NuGet Package Metadata -->
    <PackageId>InferenceEngine.Core</PackageId>
    <!-- Version is set by CI/CD workflow using VERSION_PREFIX and github.run_number -->
    <!-- Local builds use this default, CI overrides with -p:Version=$VERSION -->
    <Version>1.2.0-dev</Version>
    <Authors>intel-agency</Authors>
    <Company>Artificial Intelligence Agency</Company>
    <Description>A cross-platform .NET library for AI inference with ONNX Runtime, featuring hardware acceleration, automatic fallback, and built-in diagnostics for provider selection.</Description>
    <PackageTags>onnx;onnxruntime;ai;inference;machine-learning;deep-learning;directml;gpu;agents;rocm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/intel-agency/inference-engine-lib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/intel-agency/inference-engine-lib</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Validate packed assets on every pack; baseline version pinning lands in Phase 2. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Title>Inference Engine</Title>
    <Copyright>Copyright © 2026 Artificial Intelligence Agency</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <!-- Set RuntimeIdentifier to the host's RID for both Debug and Release builds.
       This makes a plain `dotnet build` invocation produce RID-specific output, so
       the post-Build MSBuild targets (symlink creation, libonnxruntime.so restore,
       etc.) fire automatically on any host. An explicit runtime-id flag on the
       command line still works as a cross-compile override. The property function
       $[System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier is
       evaluated at MSBuild evaluation time and returns e.g. linux-x64, win-x64,
       osx-arm64 depending on the host. -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug' OR '$(Configuration)' == 'Release'">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>
  <!-- SourceLink + symbol package: produce a portable .pdb and a separate .snupkg
       so the main .nupkg stays lean and consumers can source-step via the NuGet.org
       symbol server. EmbedUntrackedSources ensures Deterministic builds for SourceLink. -->
  <PropertyGroup>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\InferenceEngine.Core.targets" Pack="true" PackagePath="buildTransitive\" />
    <Content Include="models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>

  </ItemGroup>

  <ItemGroup><!-- Base Runtime (CPU) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" GeneratePathProperty="true" /><!-- Logging Abstraction -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" /><!-- Tensors support -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions" Version="0.14.0" />
    <!-- Tokenizer support for text embedding/generation engines -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <!-- Expose internal text math helpers to the test project for hermetic verification. -->
    <InternalsVisibleTo Include="InferenceEngine.Tests" />
    <!-- SourceLink: enables source stepping from the NuGet.org symbol server -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All" />
  </ItemGroup><!-- Conditional References for Hardware Acceleration -->
  <!-- DirectML EP is Windows-RID only — gated on RuntimeIdentifier so cross-RID builds never resolve DirectML assets. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.1" />
  </ItemGroup>
  <!-- MIGraphX EP native libs — included unconditionally on Linux x64.
       The MIGraphX-enabled libonnxruntime.so from the InferenceEngine.ROCm.Runtime.linux-x64
       package is safe to load on all hosts: it fails gracefully with managed exceptions when
       the MIGraphX runtime (libmigraphx_c.so.3) is not installed, unlike the old ROCm EP
       which SIGSEGVed in its .init section on non-ROCm hosts. At runtime,
       BaseInferenceEngine.ConfiguredSessionOptions checks /dev/kfd and the HSA runtime
       before attempting to append the MIGraphX EP; on non-ROCm hosts the engine falls
       back to CPU automatically.

       The MIGraphX EP replaced the deprecated ROCm EP in ORT v1.24.1. The native package
       version now matches the base Microsoft.ML.OnnxRuntime managed bindings (both 1.24.1). -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' AND '$(RuntimeIdentifier)' == 'linux-x64'">
    <PackageReference Include="InferenceEngine.ROCm.Runtime.linux-x64" Version="1.24.1.44" GeneratePathProperty="true" />
  </ItemGroup>
  <!-- CoreML EP is included in the base Microsoft.ML.OnnxRuntime package on macOS.
       No separate NuGet package exists for CoreML acceleration. -->

  <!-- The upstream Microsoft.ML.OnnxRuntime 1.24.1 and Microsoft.ML.OnnxRuntime.Extensions 0.14.0
       props unconditionally add <None Include="...\runtimes\win-x64\native\onnxruntime.dll"> (and
       ortextensions.dll, onnxruntime_providers_shared.dll) with <CopyToOutputDirectory>PreserveNewest</>.
       The Include attribute expands to a full NuGet-cache path, which is the item's Identity. On a
       non-Windows RID build, dlopen would find these Windows PE32+ files at the output root first and
       reject them with "invalid ELF header" before falling through to libonnxruntime.so (different
       name, so runtimes-subdir probing does not rescue). The MSBuild-correct way to neutralize this is
       to physically remove the files from the output after Build. The matching Linux .so files are
       already in place via RID-based resolution. -->
  <Target Name="RemoveWindowsNativeLibsOnNonWindows"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win'))">
    <Delete Files="$(OutDir)onnxruntime.dll"
            ContinueOnError="true" />
    <Delete Files="$(OutDir)ortextensions.dll"
            ContinueOnError="true" />
    <Delete Files="$(OutDir)onnxruntime_providers_shared.dll"
            ContinueOnError="true" />
  </Target>

  <!-- The Microsoft.ML.OnnxRuntime 1.24.1 package's P/Invoke declarations on Linux use
       a Windows-style DllImport name ("onnxruntime.dll"). .NET 10's P/Invoke search
       algorithm probes for libonnxruntime.dll.so, onnxruntime.dll.so, libonnxruntime.dll,
       and onnxruntime.dll in the output dir and the system path — but NOT for
       libonnxruntime.so (the actual filename the package ships). To make the Linux
       native library findable, create symlinks from the searched names to the
       libonnxruntime.so / libortextensions.so / libonnxruntime_providers_*.so files
       that RID-based resolution already placed in the output. macOS uses .dylib files
       and does not need these Linux-specific symlinks, so the target is gated on the
       Linux RID only. It is additionally restricted to Unix hosts (where the `ln`
       command exists) to avoid noisy errors when cross-compiling for Linux on Windows.
       The symlinks are tiny and removed by `dotnet clean`. -->
  <Target Name="SymlinkLinuxNativeLibsForPInvoke"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('linux')) AND '$(OS)' == 'Unix'">
    <Exec Command="ln -sf libonnxruntime.so            $(OutDir)libonnxruntime.dll.so"
          ContinueOnError="true" />
    <Exec Command="ln -sf libortextensions.so          $(OutDir)libortextensions.dll.so"
          ContinueOnError="true" />
    <Exec Command="ln -sf libonnxruntime_providers_shared.so $(OutDir)libonnxruntime_providers_shared.dll.so"
          ContinueOnError="true" />
    <Exec Command="ln -sf libonnxruntime_providers_migraphx.so   $(OutDir)libonnxruntime_providers_migraphx.dll.so"
           ContinueOnError="true" />
    <Exec Command="ln -sf libonnxruntime.so            $(OutDir)onnxruntime.dll"
           ContinueOnError="true" />
    <Exec Command="ln -sf libortextensions.so          $(OutDir)ortextensions.dll"
           ContinueOnError="true" />
    <Exec Command="ln -sf libonnxruntime_providers_shared.so $(OutDir)onnxruntime_providers_shared.dll"
           ContinueOnError="true" />
    <Exec Command="ln -sf libonnxruntime_providers_migraphx.so   $(OutDir)onnxruntime_providers_migraphx.dll"
           ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="InferenceEngine.Tests" />
  </ItemGroup>

  <!-- M5: Standalone Core build must also resolve the MIGraphX-capable libonnxruntime.so (the
       buildTransitive target only runs for CONSUMERS). Inline targets run when building Core
       itself, and here the ROCm runtime is a DIRECT PackageReference so $(Pkg...) is populated. -->
  <Target Name="ForceRocmOnnxRuntimeLibOnLinuxStandalone"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <PropertyGroup>
      <_RocmOrtLibStandalone>$(PkgInferenceEngine_ROCm_Runtime_linux_x64)/runtimes/linux-x64/native/libonnxruntime.so</_RocmOrtLibStandalone>
    </PropertyGroup>
    <Copy SourceFiles="$(_RocmOrtLibStandalone)"
          DestinationFiles="$(OutDir)libonnxruntime.so"
          SkipUnchangedFiles="false"
          ContinueOnError="true"
          Condition="Exists('$(_RocmOrtLibStandalone)')" />
  </Target>
</Project>
