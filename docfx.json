{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "rules": {
    "InvalidFileLink": "suggestion"
  },
  "metadata": [
    {
      "src": [
        {
          "src": "InferenceEngine.Core",
          "files": [
            "InferenceEngine.Core.csproj"
          ]
        }
      ],
      "output": "api"
    }
  ],
  "build": {
    "content": [
      {
        "src": "docs",
        "files": [
          "index.md",
          "toc.yml",
          "consumer-integration-guide.md",
          "streaming-inference-guide.md",
          "text-engines-guide.md"
        ]
      },
      {
        "files": [
          "api/*.yml",
          "api/index.md"
        ]
      }
    ],
    "resource": [],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "InferenceEngine.Core",
      "_appTitle": "InferenceEngine.Core",
      "_enableSearch": true,
      "_appFooter": "<span>MIT License © 2026 Artificial Intelligence Agency — <a href=\"https://github.com/intel-agency/inference-engine-lib\" target=\"_blank\" rel=\"noopener\">inference-engine-lib on GitHub</a></span>",
      "pdf": false
    }
  }
}