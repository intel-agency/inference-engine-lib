<?xml version="1.0" encoding="utf-8"?>
<!--
  Central Package Management: all NuGet package versions live here.
  Projects reference packages WITHOUT Version attributes; per-project
  exceptions use VersionOverride (InferenceEngine.Core.IntegrationTests
  deliberately pins the older xUnit v2 test stack).

  This file pins DIRECT versions only; the transitive graph is pinned by the
  per-rid lock files in lockfiles/ (see Directory.Build.props), which CI
  restores in locked mode so a stale lock fails the build.

  Note: a bare version here means "at least this version" (it resolves to the
  floating range [x.y.z, )). Write [x.y.z] instead for an exact pin. OSSF
  Scorecard's Pinned-Dependencies check only counts the bracketed form as
  fixed, so unbracketed versions are reported as unpinned even though they
  are exact in practice - see docs/OSSF Scorecard Pinned.md.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime couplet: the managed ORT version is coupled to the
         InferenceEngine.ROCm.Runtime.linux-x64 native package and to
         OnnxRuntime.DirectML. Neither native package is published past 1.24.x
         (DirectML tops out at 1.24.4, the ROCm runtime at 1.24.1.62), so ORT
         can only move as a coordinated release — never on a dependabot bump.
         Both semver-minor and semver-major are ignored in dependabot.yml. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Extensions" Version="0.14.0" />
    <PackageVersion Include="InferenceEngine.ROCm.Runtime.linux-x64" Version="1.24.1.62" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Examples -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
  </ItemGroup>
</Project>
