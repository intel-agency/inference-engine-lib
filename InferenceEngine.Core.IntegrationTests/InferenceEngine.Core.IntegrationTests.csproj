<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ROCm workflows pass -runtime linux-x64 explicitly; non-Linux builds use the host RID -->
    <UseRidGraph>true</UseRidGraph>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Set RuntimeIdentifier to the host's RID for both Debug and Release builds.
       This makes a plain `dotnet build` invocation produce RID-specific output
       so the test assembly lands at bin/<Config>/net10.0/<rid>/ (matching the
       .NET Core Launch (console, IntegrationTests, Debug, linux-x64) launch
       config's hardcoded program path) and so the .NET runtime's RID-aware
       native-assets resolver finds the runtimes/linux-x64/native/libonnxruntime.so
       transitively pulled in by InferenceEngine.Core. An explicit runtime-id
       flag on the command line still works as a cross-compile override. The
       property function
       $[System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier
       is evaluated at MSBuild evaluation time and returns e.g. linux-x64,
       win-x64, osx-arm64 depending on the host. -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug' OR '$(Configuration)' == 'Release'">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Older xUnit v2 stack deliberately kept: pinned via VersionOverride against the central versions. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="17.14.1" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../InferenceEngine.Core/InferenceEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources/identity.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
